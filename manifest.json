{
  "manifest_version": 3,
  "name": "TrustGuard AI",
  "version": "0.1.0",
  "description": "Spot deceptive urgency, hidden cost, and confirmshaming patterns while you browse.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://localhost:8000/*"],
  "action": {
    "default_title": "Scan this page with TrustGuard",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  }
}